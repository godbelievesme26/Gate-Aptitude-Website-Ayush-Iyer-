      "year": 2025,
      "paper": "CE2",
      "subject": "General Aptitude",
      "marks": 1,
      "question": "Even though I had planned to go skiing with my friends, I had to __________ at the last moment because of an injury. Select the most appropriate option to complete the above sentence.",
      "options": [
        {
          "label": "A",
          "text": "back up"
        },
        {
          "label": "B",
          "text": "back of"
        },
        {
          "label": "C",
          "text": "back on"
        },
        {
          "label": "D",
          "text": "back out"
        }
      ],
      "sourceImage": "figures/day11-q01.png",
      "source": {
        "file": "Aptitude Sets/2025/CE2.pdf",
        "pages": [
          {
            "page": 1,
            "bbox": [
