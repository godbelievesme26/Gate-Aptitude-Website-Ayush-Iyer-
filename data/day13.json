    {
      "id": "gate-2025-cs2-ga-09",
      "number": 9,
      "year": 2025,
      "paper": "CS2",
      "subject": "General Aptitude",
      "marks": 2,
      "question": "In the given figure, PQRS is a square of side 2 cm and PLMN is a rectangle. The corner L of the rectangle is on the side QR. Side MN of the rectangle passes through the corner S of the square. What is the area (in cm2) of the rectangle PLMN? Note: The figure shown is representative.",
      "options": [
        {
          "label": "A",
          "text": "2√2"
        },
        {
          "label": "B",
          "text": "2"
        },
        {
          "label": "C",
          "text": "8"
        },
        {
          "label": "D",
          "text": "4"
        }
      ],
      "sourceImage": "figures/day13-q09.png",
      "source": {
        "file": "Aptitude Sets/2025/CS2.pdf",
        "pages": [
          {
            "page": 9,
            "bbox": [
              35,
              99.17,
              565.32,
              512.47
            ]
          }
        ],
        "sha256": "6ed18668acb46b636ca0badf132d904756e4377a9972e8484a05eaebe9f17ddd"
      },
      "transcriptionStatus": "source-verified",
      "gradingStatus": "official key verified",
      "hasFigure": true,
      "solution": "Triangle PLS has base PS=2 cm and perpendicular height 2 cm because L lies on QR. Its area is therefore 2 cm². In rectangle PLMN, S lies on the side MN parallel to PL, so triangle PLS has the rectangle’s full base PL and full height, and occupies half its area. Rectangle area=2×2=4 cm². Answer: D.",
      "solutionStatus": "independently checked editorial solution; not an official solution",
      "type": "MCQ",
