    {
      "id": "gate-2025-cs2-ga-05",
      "number": 5,
      "year": 2025,
      "paper": "CS2",
      "subject": "General Aptitude",
      "marks": 1,
      "question": "Let p_{1} and p_{2} denote two arbitrary prime numbers. Which one of the following statements is correct for all values of p_{1} and p_{2}?",
      "options": [
        {
          "label": "A",
          "text": "p_{1} + p_{2} is not a prime number."
        },
        {
          "label": "B",
          "text": "p_{1}p_{2} is not a prime number."
        },
        {
          "label": "C",
          "text": "p_{1} + p_{2} + 1 is a prime number."
        },
        {
          "label": "D",
          "text": "p_{1}p_{2} + 1 is a prime number."
        }
      ],
      "sourceImage": "figures/day13-q05.png",
      "source": {
        "file": "Aptitude Sets/2025/CS2.pdf",
        "pages": [
          {
            "page": 5,
            "bbox": [
              35,
              99.17,
              565.32,
              343.25
            ]
          }
        ],
        "sha256": "6ed18668acb46b636ca0badf132d904756e4377a9972e8484a05eaebe9f17ddd"
      },
      "transcriptionStatus": "source-verified",
      "gradingStatus": "official key verified",
      "hasFigure": false,
      "solution": "The product p₁p₂ has the prime factor p₁ and exceeds it because p₂≥2, so it is always composite, including p₁=p₂. The sum can be prime (2+3=5), the sum-plus-one can be composite (2+3+1=6), and the product-plus-one can be composite (3×5+1=16). Answer: B.",
      "solutionStatus": "independently checked editorial solution; not an official solution",
      "type": "MCQ",
      "answer": "B",
      "answerSource": {
        "url": "https://gate2025.iitr.ac.in/doc/2025/2025_Key/CS2_Keys.pdf",
        "paper": "CS2",
        "questionNumber": 5,
        "section": "GA",
        "session": 2,
        "verifiedOn": "2026-10-05",
