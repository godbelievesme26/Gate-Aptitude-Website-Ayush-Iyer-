    {
      "id": "gate-2025-cs2-ga-03",
      "number": 3,
      "year": 2025,
      "paper": "CS2",
      "subject": "General Aptitude",
      "marks": 1,
      "question": "If Pe^{x} = Qe^{−x} for all real values of x, which one of the following statements is true?",
      "options": [
        {
          "label": "A",
          "text": "P = Q = 0"
        },
        {
          "label": "B",
          "text": "P = Q = 1"
        },
        {
          "label": "C",
          "text": "P = 1; Q = −1"
        },
        {
          "label": "D",
          "text": "P/Q = 0"
        }
      ],
      "sourceImage": "figures/day13-q03.png",
      "source": {
        "file": "Aptitude Sets/2025/CS2.pdf",
        "pages": [
          {
            "page": 3,
            "bbox": [
              35,
              99.17,
              565.32,
              358.01
            ]
          }
        ],
        "sha256": "6ed18668acb46b636ca0badf132d904756e4377a9972e8484a05eaebe9f17ddd"
      },
      "transcriptionStatus": "source-verified",
      "gradingStatus": "official key verified",
      "hasFigure": false,
      "solution": "Set x=0 to obtain P=Q. Set x=1, giving Pe=Pe^{−1}; because e≠e^{−1}, P must be 0 and hence Q=0. These values satisfy the equality for every real x. P/Q is then undefined, not zero. Answer: A.",
      "solutionStatus": "independently checked editorial solution; not an official solution",
      "type": "MCQ",
      "answer": "A",
      "answerSource": {
        "url": "https://gate2025.iitr.ac.in/doc/2025/2025_Key/CS2_Keys.pdf",
