/* The study workspace: one reading surface, with open supporting context. */
.solving{background:var(--color-study-canvas)}
.solving .question-heading{padding-bottom:var(--space-5);border-bottom:1px solid var(--color-border)}
.solving .source-label{color:var(--color-accent)}
.solving .status-summary{border-bottom-color:var(--color-study-edge)}
.question-content{max-width:72ch;margin-inline:0}
.detail>.question-content{margin-top:var(--space-6)}
.math-overline{text-decoration:overline;text-decoration-thickness:1px}
.question-stem{white-space:pre-line;font-size:1.125rem;line-height:1.8;color:var(--color-text);overflow-wrap:anywhere}
.question-content sup,.question-content sub,.option-copy sup,.option-copy sub,.prose sup,.prose sub{font-size:.75em;line-height:0}
.question-figures{display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-start;gap:var(--space-5);margin:var(--space-6) 0}
.question-figures figure{margin:0;min-width:0;max-width:100%}
.question-figures figcaption{font-size:var(--text-sm);font-weight:var(--weight-semibold);margin-bottom:var(--space-2)}
.content-figure{display:block;width:auto;max-width:100%;max-height:340px;object-fit:contain;background:var(--color-paper);padding:8px;border-radius:var(--radius-sm)}
.figure-sequence{display:grid}
.content-table-wrap{max-width:100%;overflow-x:auto;margin-block:var(--space-5)}
.content-table{border-collapse:collapse;font-size:var(--text-body);width:100%;text-align:left}
.content-table th,.content-table td{padding:var(--space-3);border-bottom:1px solid var(--color-border);vertical-align:top}
.content-table th{font-weight:var(--weight-semibold);background:var(--color-option-surface)}
.option-copy{display:grid;gap:var(--space-2);flex:1;min-width:0;text-align:left;font-size:var(--text-body);font-weight:var(--weight-regular);line-height:1.6;overflow-wrap:anywhere}
.option-figure{display:block;width:auto;max-width:100%;max-height:190px;object-fit:contain;object-position:left center;background:var(--color-paper);padding:8px;border-radius:var(--radius-sm)}
.detail-options{list-style:none;padding:0;margin-block:var(--space-6);display:grid;gap:var(--space-3)}
.detail-options li{display:flex;align-items:center;gap:var(--space-5);border-bottom:1px solid var(--color-border);padding:var(--space-4) 0}
.detail-options .option-letter{flex:0 0 28px}
:root{--radius-study:20px;--radius-answer:12px;--study-shadow:0 8px 32px rgb(31 38 57 / .035);--answer-edge:#858e9f}
[data-theme=dark]{--study-shadow:0 8px 32px rgb(0 0 0 / .1);--answer-edge:#727b8c}
.solving main{max-width:1280px;padding:32px 32px 56px}
.solving #main:focus,.solve-position h1:focus{outline:none}
.solving .topbar{height:64px;background:transparent}
.solving .top-actions>.caption,.solving .top-actions>.pill,.solving .avatar{display:none}
.solving .sidebar-action{background:transparent;color:var(--color-text-muted);border-color:var(--color-border)}
.solve-experience{max-width:1100px;margin-inline:auto}
.solve-header{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:24px}
.solve-mode{font-size:.875rem;line-height:1.5;color:var(--color-text-muted);margin-bottom:8px}
.solve-mode span{color:var(--color-text-muted)}
.solve-position{display:flex;align-items:baseline;gap:12px}
.solve-position h1{font-size:1.875rem;line-height:1.2;letter-spacing:-.025em}
.solve-position>span{font-size:.9375rem;color:var(--color-text-muted)}
.solve-header-actions{display:flex;flex-direction:column;align-items:stretch;gap:8px;min-width:120px}
.solve-header-actions .quiet{min-height:40px;font-size:.8125rem;padding:8px 12px}
.session-progress{height:3px;margin:0;border-radius:2px}
.quiz-grid{display:grid;grid-template-columns:minmax(0,1fr) 168px;gap:28px;align-items:start}
.question-surface{min-width:0;padding:28px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-study);box-shadow:var(--study-shadow)}
.question-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px}
.question-heading>div:first-child{display:grid;gap:4px}
.source-label{font-size:.75rem;font-weight:600;color:var(--color-text-muted);letter-spacing:.04em}
.source-context{font-size:.9375rem;font-weight:600}
.source-context>span{font-weight:400;color:var(--color-text-muted)}
.marking{display:grid;gap:4px;text-align:right}
.marking strong{font-size:.875rem;font-weight:600}
.marking span{font-size:.8125rem;color:var(--color-text-muted);line-height:1.4}
.question-document{min-width:0}
.question-document .source-frame{margin:0 0 12px;padding:12px;border:0;background:#fff;border-radius:12px;overflow:hidden}
.question-document .question-image{max-width:720px;width:100%;height:auto;border-radius:0;object-fit:contain}
.paper-hint{display:none}
.source-tools{display:flex;align-items:baseline;justify-content:space-between;gap:8px 24px;flex-wrap:wrap}
.source-tools>button{background:transparent;border-color:transparent;color:var(--color-accent);font-size:.8125rem;min-height:44px;padding:8px 0}
.source-tools>button:hover{color:var(--color-text);text-decoration:underline;text-underline-offset:4px}
.source-tools>details{font-size:.8125rem;color:var(--color-text-muted);line-height:1.5}
.source-tools>details[open]{flex-basis:100%}
.question-document summary{cursor:pointer;padding:8px 0;min-height:40px}
.question-document .prose{padding-block:12px;font-size:.9375rem;overflow-wrap:anywhere}
.response-section{border-top:1px solid var(--color-border);margin-top:20px;padding-top:24px}
.response-section .section-head{margin-bottom:16px;gap:12px}
.response-section h2{font-size:1.125rem;line-height:1.3}
.response-section .caption{font-size:.875rem}
.answer-panel{display:grid;grid-template-columns:minmax(0,1fr);gap:10px;border:0;padding:0;margin:0 0 24px;min-width:0}
.answer-panel input{grid-column:1/-1;width:100%;min-height:60px;font-size:1.125rem;border-color:var(--answer-edge);border-radius:var(--radius-answer)}
.answer-panel .option{position:relative;display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:66px;min-width:0;padding:14px 16px;background:var(--color-option-surface);border:1px solid var(--answer-edge);border-radius:var(--radius-answer);color:var(--color-text);box-shadow:none;transition:background-color var(--motion-fast) var(--ease-standard),border-color var(--motion-fast) var(--ease-standard),box-shadow var(--motion-fast) var(--ease-standard),transform var(--motion-fast) var(--ease-standard)}
.option-letter{flex:0 0 28px;font-size:1rem;font-weight:600;line-height:1.5}
.option-state{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.option-indicator{display:grid;place-items:center;flex:0 0 18px;width:18px;height:18px;border:1px solid var(--answer-edge);border-radius:50%;font-size:.75rem}
.answer-panel .option:hover:not(:disabled){background:var(--color-surface-elevated);border-color:var(--color-accent);box-shadow:0 2px 6px rgb(31 38 57 / .04)}
.answer-panel .option.selected,.answer-panel .option[aria-pressed=true]{border-color:var(--color-accent);background:var(--color-accent-soft);color:var(--color-accent);box-shadow:inset 0 0 0 1px var(--color-accent)}
.option.selected .option-indicator{background:var(--color-accent);border-color:var(--color-accent);color:var(--color-on-accent)}
.answer-panel .option:active:not(:disabled){transform:translateY(1px)}
.answer-panel .option:focus-visible{outline:var(--focus-ring);outline-offset:4px}
.answer-panel .option:disabled{opacity:.5;background:var(--color-canvas);cursor:not-allowed;transform:none;box-shadow:none}
.answer-panel .option[data-feedback=correct]{border-color:var(--color-success);color:var(--color-success);background:color-mix(in srgb,var(--color-success) 8%,var(--color-surface));box-shadow:inset 0 0 0 1px var(--color-success)}
.answer-panel .option[data-feedback=incorrect]{border-color:var(--color-error);color:var(--color-error);background:color-mix(in srgb,var(--color-error) 6%,var(--color-surface));box-shadow:inset 0 0 0 1px var(--color-error)}
.answer-panel .option[data-feedback] .option-indicator{background:transparent;border-color:currentColor;color:inherit}
.solve-actions{display:flex;align-items:center;justify-content:space-between;gap:16px}
.solve-actions>.primary{min-width:168px;min-height:48px;border-radius:10px;padding:14px 24px;background:var(--color-accent);color:var(--color-on-accent);border-color:var(--color-accent);box-shadow:0 2px 4px rgb(31 38 57 / .08)}
.solve-actions>.primary:hover:not(:disabled){background:var(--color-accent-hover);border-color:var(--color-accent-hover);color:var(--color-on-accent);transform:translateY(-1px)}
.solve-actions>.primary:active:not(:disabled){transform:translateY(1px);box-shadow:none}
.solve-actions>.primary:disabled{transform:none;box-shadow:none;opacity:.5}
.solve-actions>.primary[aria-busy=true]{cursor:progress}
.answer-save-note{font-size:.8125rem;line-height:1.55;color:var(--color-text-muted);margin:16px 0 0;max-width:64ch}
.solve-tools{display:flex;flex-wrap:wrap;gap:4px 16px;border-top:1px solid var(--color-border);padding-top:12px;margin-top:20px}
.solve-tools .quiet{padding:10px 0;min-height:44px;border:0;border-radius:4px;background:transparent;font-size:.8125rem;color:var(--color-text-muted)}
.solve-tools .quiet:hover{color:var(--color-accent);text-decoration:underline;text-underline-offset:4px}
.quiz-support{position:sticky;top:24px;order:0;padding-top:20px;min-width:0}
.status-summary{display:flex;align-items:baseline;gap:8px;border-bottom:1px solid var(--color-border);padding-bottom:16px}
.status-summary strong{font-size:1.125rem;font-weight:600;font-variant-numeric:tabular-nums}
.status-summary>span{color:var(--color-text-muted);font-size:.8125rem}
.timing{display:grid;gap:20px;padding-block:24px}
.timing>div{display:grid;gap:4px}
.timing span,.timing small{font-size:.8125rem;color:var(--color-text-muted)}
.timing strong{font-size:1.25rem;line-height:1.3;font-weight:500;font-variant-numeric:tabular-nums;letter-spacing:.025em}
.timing>div:nth-child(2) strong{font-size:1rem}
.question-navigation{border-top:1px solid var(--color-border);padding-top:12px}
.question-navigation summary{font-size:.8125rem;cursor:pointer;min-height:44px;display:flex;align-items:center;gap:8px;color:var(--color-text-muted)}
.question-navigation summary::before{content:'›';font-size:1.25rem;transition:transform var(--motion-fast)}
.question-navigation[open] summary::before{transform:rotate(90deg)}
.question-navigation .palette{grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:8px 0 12px}
.question-navigation .palette button{min-height:44px;border-radius:8px;font-size:.8125rem}
.quiz-support .keyboard{font-size:.75rem;line-height:1.8;margin-top:16px;display:block}
.quiz-support .checkpoint{background:transparent;padding:12px 0 12px 12px;margin:0 0 16px;font-size:.875rem}
.question-surface.question-enter{animation:study-enter var(--motion-view) var(--ease-standard) both}
dialog:has(.source-reader){max-width:1040px}
.source-reader{overflow:auto;max-height:65vh;background:white;border:1px solid var(--color-border);border-radius:12px}
.source-reader img{display:block;width:900px;max-width:none;background:white;margin-inline:auto}
@media(max-width:680px){dialog:has(.source-reader){width:calc(100% - 16px);max-height:calc(100dvh - 16px);padding:16px}.source-reader{max-height:calc(100dvh - 220px)}dialog:has(.source-reader) .actions{margin-top:16px}}
@keyframes study-enter{from{opacity:.75;transform:translateY(4px)}to{opacity:1;transform:none}}

/* Recorded feedback is textual as well as semantic in color. */
.feedback-list{display:grid;margin-top:16px}
.feedback-row{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:24px 0;border-bottom:1px solid var(--color-border)}
.feedback-row:last-child{border-bottom:0}
.feedback-copy{display:flex;align-items:start;gap:14px;min-width:0}
.feedback-mark{display:grid;place-items:center;flex:0 0 28px;width:28px;height:28px;border:1px solid currentColor;border-radius:50%;font-size:.875rem;color:var(--color-text-muted)}
.feedback-row[data-result=correct] .feedback-mark{color:var(--color-success)}
.feedback-row[data-result=incorrect] .feedback-mark{color:var(--color-error)}
.feedback-row strong{font-size:1rem;font-weight:600}
.feedback-row p{margin:6px 0 8px;font-size:.9375rem;line-height:1.6;max-width:60ch}
.feedback-row .caption{font-size:.875rem;line-height:1.6}
.feedback-row .text-link{display:inline-flex;align-items:center;min-height:44px;white-space:nowrap}

@media(max-width:1200px){.quiz-grid{grid-template-columns:minmax(0,1fr)}.solve-experience{max-width:880px}.quiz-support{position:static;display:grid;grid-template-columns:1fr 2fr;gap:0 32px;padding:0 16px;order:0}.status-summary{border-bottom:0}.timing{grid-column:2;grid-row:1;display:flex;justify-content:space-between;gap:24px;padding:0}.question-navigation{grid-column:1/-1;margin-top:20px}.question-navigation .palette{grid-template-columns:repeat(auto-fit,minmax(44px,1fr));max-width:600px}.quiz-support .checkpoint{grid-column:1/-1;margin-top:16px}.quiz-support .keyboard{grid-column:1/-1;margin:0}.timing small{align-self:end}}
@media(min-width:681px) and (max-width:1150px){.solving .sidebar{display:none;top:64px;width:230px;overflow-y:auto}.solving .sidebar.open{display:flex;box-shadow:var(--shadow-overlay)}.solving .workspace{margin-left:0}.solving .mobile-menu{display:inline-flex}.solving .topbar{justify-content:start}.solving .top-actions{margin-left:auto}}
@media(max-width:680px){.solving main{padding:24px 16px 40px}.solving .topbar{height:56px;padding-inline:16px}.solving .sidebar{top:56px;overflow-y:auto}.solve-header{gap:12px;margin-bottom:20px}.solve-mode{font-size:.8125rem}.solve-mode span{display:none}.solve-position h1{font-size:1.625rem}.solve-position>span{font-size:.875rem}.solve-position{gap:8px}.solve-header-actions{min-width:100px}.quiz-grid{gap:24px}.question-surface{padding:20px 16px;border-radius:16px}.question-heading{align-items:start;gap:12px;margin-bottom:20px}.source-context{font-size:.875rem}.source-context>span{display:block;margin-top:2px}.marking{max-width:128px}.marking span{font-size:.75rem;white-space:normal}.question-document .source-frame{padding:4px;border-radius:8px;margin-inline:-8px}.question-document>button{min-height:44px}.response-section{margin-top:16px;padding-top:20px}.response-section .caption{font-size:.8125rem}.answer-panel{grid-template-columns:minmax(0,1fr);gap:10px;margin-bottom:20px}.answer-panel .option{min-height:60px;padding:14px 16px}.solve-actions{gap:12px}.solve-actions>.primary{min-width:0;flex:1;padding:14px 16px}.solve-actions>.quiet{padding-inline:8px;font-size:.8125rem}.solve-tools{gap:4px 16px}.quiz-support{padding-inline:4px;grid-template-columns:1fr;gap:16px}.timing{grid-column:1;grid-row:auto;flex-wrap:wrap;gap:16px 24px}.timing small{flex-basis:100%}.question-navigation{margin-top:0}.feedback-row{align-items:start;flex-direction:column;gap:8px;padding:20px 0}.feedback-row .text-link{margin-left:42px;white-space:normal}.feedback-copy{gap:12px}.feedback-row .caption{overflow-wrap:anywhere}}
@media(prefers-reduced-motion:reduce){.question-surface.question-enter{animation:none}.answer-panel .option,.solve-actions>.primary,.question-navigation summary::before{transition:none;transform:none}.solve-actions>.primary:hover,.solve-actions>.primary:active,.answer-panel .option:active{transform:none}}
@media(max-width:380px){.solve-header-actions{min-width:80px}.solve-header-actions .quiet{padding-inline:4px;font-size:.75rem}.solve-position{gap:6px;flex-wrap:wrap}.solve-position h1{font-size:1.5rem;white-space:nowrap}.solve-position>span{font-size:.75rem;white-space:nowrap}}
@media(max-width:680px){.question-document .source-frame{overflow:auto;max-height:56vh;overscroll-behavior-x:contain;scrollbar-width:thin;scrollbar-color:var(--answer-edge) #fff;border:1px solid var(--color-border)}.question-document .question-image{width:600px;min-width:600px;max-width:none;margin:0}.paper-hint{display:block;font-size:.8125rem;line-height:1.5;margin:0 0 12px;color:var(--color-text-muted)}.source-tools{gap:0}.question-document summary{min-height:44px}}

/* Structured content: preserve tabular relationships without source-page images. */
.content-table-grouped td{border:1px solid var(--color-border);text-align:center}
.content-table-grouped tr:nth-child(2) td{border-bottom:3px double var(--color-text-muted)}
.content-table-grouped td:nth-child(2){border-right:3px double var(--color-text-muted)}
.question-preview{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.feedback-row:has(.feedback-solution){display:grid;grid-template-columns:minmax(0,1fr) auto}
.feedback-solution{grid-column:1/-1;min-width:0;margin-top:var(--space-3)}
.feedback-solution summary{cursor:pointer;min-height:44px;padding-block:var(--space-3);font-size:var(--text-control);color:var(--color-accent)}
.feedback-solution[open]{padding-top:var(--space-3);border-top:1px solid var(--color-border)}
.feedback-solution .question-content{margin-top:var(--space-4)}
.feedback-solution h3{margin-top:var(--space-6)}
.feedback-solution .prose{white-space:pre-line}
@media(max-width:680px){.feedback-row:has(.feedback-solution){grid-template-columns:minmax(0,1fr)}.feedback-solution .text-link{margin-left:0}}

/* Source notation extensions; existing GA notation/layout remains unchanged. */
.math-fraction{display:inline-flex;flex-direction:column;vertical-align:middle;text-align:center;line-height:1.3;margin-inline:.16em}
.math-fraction>span:first-child{border-bottom:1px solid currentColor;padding:0 .15em .1em}
.math-fraction>span:last-child{padding:.1em .15em 0}
.math-matrix{display:inline-grid;grid-template-columns:repeat(var(--matrix-columns),auto);gap:.15em .6em;border-inline:1px solid currentColor;padding:.15em .35em;vertical-align:middle;text-align:center}
.content-math{display:block;margin-block:var(--space-4);line-height:1.8;overflow-wrap:anywhere}
.question-group{margin-bottom:var(--space-5);padding-bottom:var(--space-4);border-bottom:1px solid var(--color-border)}
